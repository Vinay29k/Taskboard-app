# Copy to .env for local development:  cp .env.example .env
# Never commit .env (it may contain secrets).

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Leave empty to use the in-memory store (no database needed).
# Set it to use PostgreSQL, e.g.:
# DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard
DATABASE_URL=
POSTGRES_USER=your_username
POSTGRES_PASSWORD=change-me
